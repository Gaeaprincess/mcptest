.container {
  padding: 10px;
}

.header {
  font-size: 20px;
  font-weight: bold;
  margin-bottom: 15px;
  padding-left: 10px;
}

.product-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.product-item {
  width: 48%;
  background: #fff;
  margin-bottom: 15px;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 2px 5px rgba(0,0,0,0.05);
}

.product-img {
  width: 100%;
  height: 150px;
  background-color: #eee;
}

.product-info {
  padding: 10px;
}

.product-name {
  font-size: 16px;
  margin-bottom: 5px;
}

.product-price {
  color: #ff5722;
  font-weight: bold;
}
